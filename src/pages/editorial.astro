---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
import { groupByStatus } from '../lib/posts';

// Editorial calendar: every post in the system, grouped by workflow status.
const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const byStatus = groupByStatus(allPosts);

const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });

// Status labels and descriptions for the editorial UI.
const statusMeta: Record<string, { label: string; description: string }> = {
  published: {
    label: 'Published',
    description: 'Live on the site and included in feeds.',
  },
  scheduled: {
    label: 'Scheduled',
    description: 'Will go live on the publish date (requires rebuild).',
  },
  in_review: {
    label: 'In Review',
    description: 'Awaiting editorial approval before going live.',
  },
  draft: {
    label: 'Draft',
    description: 'Work in progress — not visible on the public site.',
  },
};
---

<BaseLayout
  title={`Editorial Calendar · ${SITE_TITLE}`}
  description="Content pipeline overview: drafts, reviews, scheduled posts, and published articles."
>
  <h1>Editorial Calendar</h1>

  <p class="intro">
    {allPosts.length} post{allPosts.length === 1 ? '' : 's'} in the pipeline.
  </p>

  {
    Object.entries(statusMeta).map(([status, meta]) => {
      const posts = byStatus[status as keyof typeof byStatus];
      return (
        <section class="status-group">
          <h2>
            {meta.label}
            <span class="count">({posts.length})</span>
          </h2>
          <p class="status-desc">{meta.description}</p>

          {posts.length === 0 ? (
            <p class="empty">No posts in this stage.</p>
          ) : (
            <ul class="post-list">
              {posts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {dateFmt.format(post.data.pubDate)}
                  </time>
                  <span class="author">by {post.data.author}</span>
                  {post.data.tags.length > 0 && (
                    <span class="tags">{post.data.tags.join(', ')}</span>
                  )}
                </li>
              ))}
            </ul>
          )}
        </section>
      );
    })
  }
</BaseLayout>

<style>
  .intro {
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }
  .status-group {
    margin-bottom: 2.5rem;
  }
  .status-group h2 {
    margin-bottom: 0.25rem;
    font-size: 1.25rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.25rem;
  }
  .count {
    font-size: 0.9rem;
    font-weight: normal;
    color: var(--muted);
    margin-left: 0.5rem;
  }
  .status-desc {
    margin: 0.25rem 0 0.75rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .empty {
    font-style: italic;
    color: var(--muted);
  }
  .post-list {
    list-style: none;
    padding: 0;
  }
  .post-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  .post-list a {
    font-weight: 500;
    min-width: 12rem;
  }
  .post-list time {
    color: var(--muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .author {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .tags {
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
