---
// SEO foundation shared by every page: title/description, canonical URL,
// OpenGraph + Twitter cards, RSS autodiscovery, and optional Article JSON-LD.
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  // Article-only structured data.
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
}

const {
  title,
  description,
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;

// Astro.site is set from `site` in astro.config.mjs. Build absolute URLs so
// crawlers and social scrapers get fully-qualified links.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;

const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        ...(socialImage ? { image: socialImage.href } : {}),
        ...(publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
        ...(modifiedTime ? { dateModified: modifiedTime.toISOString() } : {}),
        ...(author ? { author: { '@type': 'Person', name: author } } : {}),
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
      }
    : null;
---

<!-- Global metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />

<!-- RSS autodiscovery -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>

<!-- Primary meta tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- OpenGraph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{socialImage && <meta property="og:image" content={socialImage} />}

<!-- Twitter -->
<meta property="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{socialImage && <meta property="twitter:image" content={socialImage} />}

<!-- Structured data (Article schema) -->
{
  structuredData && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  )
}
