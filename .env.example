# Copy to .env for local overrides. NEVER commit real secrets — .env is gitignored.

# Canonical production URL (used for sitemap, RSS, canonical + OpenGraph tags).
SITE_URL=https://blog.beligh.example

# Claude API key for AI-assisted drafting tooling (see future BEL tickets).
# Read from the environment at runtime; do not hardcode anywhere in the repo.
# ANTHROPIC_API_KEY=

# GoatCounter subdomain code for privacy-friendly analytics (BEL-7).
# Set this to your GoatCounter code (e.g. "myblog" for https://myblog.goatcounter.com).
# Leave unset to disable analytics entirely.
# GOATCOUNTER_CODE=
